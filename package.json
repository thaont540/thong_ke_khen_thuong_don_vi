{
  "name": "app-nghia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@hono/zod-validator": "0.9.1",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.2",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-router": "8.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.2",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.151.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "create-admin": "tsx scripts/create-admin.ts",
    "cf-typegen": "wrangler types",
    "test:worker": "vitest run -c vitest.worker.config.ts",
    "test:client": "vitest run -c vitest.client.config.ts",
    "test": "npm run test:worker && npm run test:client",
    "test:e2e": "playwright test",
    "check:file-lines": "node scripts/check-file-lines.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && wrangler d1 migrations apply DB --env staging --remote && wrangler deploy",
    "deploy:prod": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  }
}
