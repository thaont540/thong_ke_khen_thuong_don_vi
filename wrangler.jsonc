{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app-nghia",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker/index.ts",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-nghia",
      "database_id": "6c30470a-011c-4130-bf04-cd53240f30ff",
      "migrations_dir": "migrations"
    }
  ],
  // Regulation documents (file bodies) in Workers KV (no card needed; 25 MiB/value, 1,000 writes/day on free)
  "kv_namespaces": [{ "binding": "DOCS", "id": "0843798cc27241ba8a7a0898e4e6b50e" }],
  // Per-IP throttle for POST /api/auth/login (code skips it when the binding is absent)
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // UTC: 17:00 = 00:00 Vietnam time
  "triggers": { "crons": ["0 17 * * *"] },
  "env": {
    "staging": {
      "name": "app-nghia-staging",
      "workers_dev": true,
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "app-nghia-staging",
          "database_id": "f9bcb8d3-e69e-421b-a96a-e7baa4971492",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "DOCS", "id": "688dc9454b9d4222b9be891b451ad1e3" }],
      "ratelimits": [
        { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
      ],
      "triggers": { "crons": ["0 17 * * *"] }
    }
  }
}
