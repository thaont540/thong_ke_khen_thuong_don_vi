{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "vite.config.ts",
    "vitest.worker.config.ts",
    "vitest.client.config.ts",
    "playwright.config.ts",
    "e2e",
    "scripts",
    "src/shared",
    "src/worker/lib/password-hash.ts",
    "src/worker/lib/temp-password.ts"
  ]
}
